# Server-side only — do NOT prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — models to use (defaults shown). The fallback is tried only when the
# primary returns 404/429/5xx. Free tier: flash-lite models allow 15 RPM / 500 RPD each.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
